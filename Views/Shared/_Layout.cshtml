@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TodoPlus</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Navbar Header -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Todo" asp-action="Index">
                    <div class="bg-indigo text-white p-2 rounded-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);">
                        <i class="bi bi-check2-square fs-5"></i>
                    </div>
                    <span class="brand-gradient fs-4">TodoPlus</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 rounded-3 text-light" asp-controller="Todo" asp-action="Index">
                                    <i class="bi bi-grid-1x2 me-1 text-indigo"></i> My Tasks
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 rounded-3 text-light" asp-controller="Todo" asp-action="Create">
                                    <i class="bi bi-plus-circle me-1 text-success"></i> New Task
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-3 py-2 rounded-3 text-warning fw-semibold" asp-controller="Admin" asp-action="Users">
                                        <i class="bi bi-shield-lock me-1"></i> Admin Panel
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3 py-2 rounded-3 text-info fw-semibold" asp-controller="Admin" asp-action="AllTodos">
                                        <i class="bi bi-database me-1"></i> All System Tasks
                                    </a>
                                </li>
                            }
                        </ul>

                        <div class="d-flex align-items-center gap-3 ms-auto mt-3 mt-lg-0">
                            @{
                                var username = User.FindFirst(ClaimTypes.Name)?.Value ?? "User";
                                var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "User";
                                var initial = string.IsNullOrEmpty(username) ? "U" : username.Substring(0, 1).ToUpper();
                            }
                            <div class="d-flex align-items-center gap-2 bg-dark bg-opacity-50 px-3 py-1-5 rounded-pill border border-secondary border-opacity-25">
                                <div class="avatar-circle">@initial</div>
                                <div class="lh-sm text-start">
                                    <div class="text-white fw-bold fs-7">@username</div>
                                    <span class="badge @(role == "Admin" ? "badge-role-admin" : "badge-role-user") px-2" style="font-size: 0.65rem;">@role</span>
                                </div>
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 ms-auto">
                            <a class="btn btn-outline-light btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                            </a>
                            <a class="btn btn-indigo text-white btn-sm rounded-pill px-3 fw-semibold" style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i> Sign Up
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- Toast Notification Banner -->
    <div class="toast-container-custom">
        @if (TempData["ToastMessage"] != null)
        {
            var toastType = TempData["ToastType"]?.ToString() ?? "success";
            var bgClass = toastType switch {
                "success" => "bg-success text-white",
                "danger" => "bg-danger text-white",
                "warning" => "bg-warning text-dark",
                _ => "bg-primary text-white"
            };
            <div class="toast show align-items-center @bgClass border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body fw-semibold d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        @TempData["ToastMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <!-- Main Content Container -->
    <div class="container py-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top bg-white py-3 mt-auto shadow-sm">
        <div class="container text-center text-muted small">
            &copy; 2026 <strong>TodoPlus App</strong> &bull; Krishna Gupta &bull; ASP.NET Core 10.0 MVC
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Auto hide toast after 4 seconds
        document.addEventListener("DOMContentLoaded", function () {
            const toastEl = document.querySelector('.toast');
            if (toastEl) {
                setTimeout(() => {
                    const bsToast = new bootstrap.Toast(toastEl);
                    bsToast.hide();
                }, 4000);
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
