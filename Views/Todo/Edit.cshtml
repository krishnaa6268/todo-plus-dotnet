@model TodoPlus.Models.TodoItem
@using TodoPlus.Models

@{
    ViewData["Title"] = "Edit Task";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-7">
        <div class="card glass-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-pencil-square text-indigo me-2" style="color: #4f46e5;"></i>Edit Task</h3>
                    <p class="text-muted small mb-0">Modify task details and update task status</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <input type="hidden" asp-for="CompletedAt" />
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="OwnerUsername" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold text-secondary small"></label>
                    <input asp-for="Title" class="form-control form-control-custom" placeholder="Task Title" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold text-secondary small"></label>
                    <textarea asp-for="Description" class="form-control form-control-custom" rows="3" placeholder="Task Description"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Priority" class="form-label fw-semibold text-secondary small"></label>
                        <select asp-for="Priority" asp-items="Html.GetEnumSelectList<Priority>()" class="form-select form-control-custom">
                        </select>
                        <span asp-validation-for="Priority" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label fw-semibold text-secondary small"></label>
                        <input asp-for="Category" class="form-control form-control-custom" placeholder="Category" />
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="DueDate" class="form-label fw-semibold text-secondary small"></label>
                        <input asp-for="DueDate" type="date" class="form-control form-control-custom" />
                        <span asp-validation-for="DueDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check form-switch bg-light p-3 rounded-3 border w-100 mb-0">
                            <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IsCompleted" id="isCompletedSwitch">
                            <label class="form-check-label fw-bold text-dark small" for="isCompletedSwitch">
                                Mark Task as Completed
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn text-white rounded-pill px-4 shadow-sm fw-bold" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border: none;">
                        <i class="bi bi-check-lg me-1"></i> Update Task
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
