@model TodoPlus.Models.TodoItem
@using TodoPlus.Models

@{
    ViewData["Title"] = "Task Details";
    var isOverdue = !Model.IsCompleted && Model.DueDate.HasValue && Model.DueDate.Value.Date < DateTime.Today;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @(Model.IsCompleted ? "bg-success" : "bg-warning text-dark") fs-6 rounded-pill px-3 py-2">
                        <i class="bi @(Model.IsCompleted ? "bi-check-circle-fill" : "bi-clock-history") me-1"></i>
                        @(Model.IsCompleted ? "Completed" : "In Progress")
                    </span>
                    @if (!string.IsNullOrEmpty(Model.Category))
                    {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle fs-6 rounded-pill px-3 py-2">
                            <i class="bi bi-tag me-1"></i> @Model.Category
                        </span>
                    }
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>

            <h2 class="fw-bold text-dark mb-3 @(Model.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                @Model.Title
            </h2>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                    <h6 class="fw-bold text-uppercase text-muted small mb-2"><i class="bi bi-card-text me-1"></i> Description</h6>
                    <p class="mb-0 text-dark" style="white-space: pre-wrap;">@Model.Description</p>
                </div>
            }

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white">
                        <span class="text-uppercase text-muted fw-semibold small d-block mb-1">Priority</span>
                        @switch (Model.Priority)
                        {
                            case Priority.High:
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-6 px-3 py-1"><i class="bi bi-exclamation-octagon me-1"></i> High Priority</span>
                                break;
                            case Priority.Medium:
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-6 px-3 py-1"><i class="bi bi-dash-circle me-1"></i> Medium Priority</span>
                                break;
                            case Priority.Low:
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle fs-6 px-3 py-1"><i class="bi bi-arrow-down-circle me-1"></i> Low Priority</span>
                                break;
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white">
                        <span class="text-uppercase text-muted fw-semibold small d-block mb-1">Due Date</span>
                        @if (Model.DueDate.HasValue)
                        {
                            <span class="fw-bold fs-6 @(isOverdue ? "text-danger" : "text-dark")">
                                <i class="bi bi-calendar-event me-1"></i> @Model.DueDate.Value.ToString("MMMM dd, yyyy")
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-2">Overdue</span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="text-muted fs-6">No due date set</span>
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white">
                        <span class="text-uppercase text-muted fw-semibold small d-block mb-1">Created At</span>
                        <span class="text-dark fs-6"><i class="bi bi-clock me-1"></i> @Model.CreatedAt.ToString("f")</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white">
                        <span class="text-uppercase text-muted fw-semibold small d-block mb-1">Completed At</span>
                        @if (Model.CompletedAt.HasValue)
                        {
                            <span class="text-success fw-bold fs-6"><i class="bi bi-check-all me-1"></i> @Model.CompletedAt.Value.ToString("f")</span>
                        }
                        else
                        {
                            <span class="text-muted fs-6">Not completed yet</span>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-between pt-3 border-top">
                <form asp-action="ToggleComplete" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn @(Model.IsCompleted ? "btn-outline-warning" : "btn-success") rounded-pill px-4">
                        <i class="bi @(Model.IsCompleted ? "bi-arrow-counterclockwise" : "bi-check-lg") me-1"></i>
                        @(Model.IsCompleted ? "Reopen Task" : "Mark Complete")
                    </button>
                </form>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this task?');">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                            <i class="bi bi-trash me-1"></i> Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
