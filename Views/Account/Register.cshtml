@model TodoPlus.Models.RegisterViewModel
@{
    ViewData["Title"] = "Sign Up";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card auth-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle p-3 mb-2" style="background: rgba(16, 185, 129, 0.1); width: 64px; height: 64px;">
                    <i class="bi bi-person-plus-fill fs-2" style="color: #10b981;"></i>
                </div>
                <h2 class="fw-extrabold text-dark mb-1">Create Account</h2>
                <p class="text-muted small">Sign up to create your own isolated todo list</p>
            </div>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label fw-semibold text-secondary small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person"></i></span>
                        <input asp-for="Username" class="form-control form-control-custom border-start-0" placeholder="johndoe" required />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-secondary small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control form-control-custom border-start-0" placeholder="john@example.com" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold text-secondary small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control form-control-custom border-start-0" placeholder="At least 6 characters" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-shield-check"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control form-control-custom border-start-0" placeholder="Re-enter password" required />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <!-- <div class="form-check mb-4 bg-light p-3 rounded-3 border">
                    <input asp-for="IsAdmin" class="form-check-input ms-0 me-2" id="adminCheck" />
                    <label asp-for="IsAdmin" class="form-check-label fw-semibold text-dark small">
                        Register as an Administrator (Admin Role)
                    </label>
                    <div class="text-muted" style="font-size: 0.75rem; margin-top: 2px;">
                        Admins can view and manage all registered users and system records.
                    </div>
                </div> -->

                <button type="submit" class="btn text-white w-100 py-2-5 fw-bold rounded-3 shadow-sm mb-3" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none;">
                    <i class="bi bi-check-circle me-1"></i> Register
                </button>
            </form>

            <div class="text-center mt-3 pt-3 border-top">
                <p class="text-muted small mb-0">Already have an account? <a asp-action="Login" class="fw-bold text-success text-decoration-none">Sign In</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
