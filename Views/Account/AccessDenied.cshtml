@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card glass-card p-5 border-danger border-opacity-25">
            <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle p-3 mb-3 mx-auto" style="width: 80px; height: 80px;">
                <i class="bi bi-shield-x fs-1"></i>
            </div>
            <h2 class="fw-extrabold text-dark mb-2">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have Administrator privileges to access this page. Admin access is required to view all user records and system data.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Todo" asp-action="Index" class="btn btn-primary px-4 rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Back to My Tasks
                </a>
            </div>
        </div>
    </div>
</div>
